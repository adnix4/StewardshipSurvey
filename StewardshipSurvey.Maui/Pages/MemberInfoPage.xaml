<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StewardshipSurvey.Maui.MemberInfoPage"
             Title="Member Information"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid RowDefinitions="*,Auto" Padding="20">
        <ScrollView>
            <VerticalStackLayout Spacing="15">
                <!-- Title -->
                <Label Text="Please verify or enter your profile information" FontSize="18" FontAttributes="Bold" />

                <!-- First Name -->
                <StackLayout Spacing="5">
                    <Label Text="First Name *" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="First Name"
                        Text="{Binding MemberInfo.FirstName}" />
                </StackLayout>

                <!-- Last Name -->
                <StackLayout Spacing="5">
                    <Label Text="Last Name *" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="Last Name"
                        Text="{Binding MemberInfo.LastName}" />
                </StackLayout>

                <!-- Email -->
                <StackLayout Spacing="5">
                    <Label Text="Email *" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="Email"
                        Keyboard="Email"
                        Text="{Binding MemberInfo.Email}" />
                </StackLayout>

                <!-- Cell Phone -->
                <StackLayout Spacing="5">
                    <Label Text="Cell Phone" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="Cell Phone"
                        Keyboard="Telephone"
                        Text="{Binding MemberInfo.CellPhoneNumber}" />
                </StackLayout>

                <!-- Home Phone -->
                <StackLayout Spacing="5">
                    <Label Text="Home Phone" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="Home Phone"
                        Keyboard="Telephone"
                        Text="{Binding MemberInfo.HomePhoneNumber}" />
                </StackLayout>

                <!-- Address -->
                <StackLayout Spacing="5">
                    <Label Text="Address" FontAttributes="Bold" />
                    <Entry 
                        Placeholder="Address"
                        Text="{Binding MemberInfo.Address}" />
                </StackLayout>

                <!-- City, State, Zip -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                    <StackLayout Spacing="5" Grid.Column="0">
                        <Label Text="City" FontAttributes="Bold" />
                        <Entry 
                            Placeholder="City"
                            Text="{Binding MemberInfo.City}" />
                    </StackLayout>
                    <StackLayout Spacing="5" Grid.Column="1">
                        <Label Text="State" FontAttributes="Bold" />
                        <Entry 
                            Placeholder="State"
                            Text="{Binding MemberInfo.State}" />
                    </StackLayout>
                    <StackLayout Spacing="5" Grid.Column="2">
                        <Label Text="Zip" FontAttributes="Bold" />
                        <Entry 
                            Placeholder="Zip"
                            Text="{Binding MemberInfo.Zip}" />
                    </StackLayout>
                </Grid>

                <!-- Birth Date -->
                <StackLayout Spacing="5">
                    <Label Text="Birth Date" FontAttributes="Bold" />
                    <DatePicker Date="{Binding MemberInfo.BirthDate, StringFormat='{0:MM/dd/yyyy}'}" />
                </StackLayout>

                <!-- Gender -->
                <StackLayout Spacing="5">
                    <Label Text="Gender" FontAttributes="Bold" />
                    <Picker x:Name="GenderPicker" Title="Select Gender">
                        <Picker.Items>
                            <x:String>Male</x:String>
                            <x:String>Female</x:String>
                        </Picker.Items>
                    </Picker>
                </StackLayout>

                <!-- Preferred Contact -->
                <StackLayout Spacing="5">
                    <Label Text="Preferred Contact Method" FontAttributes="Bold" />
                    <StackLayout Spacing="10">
                        <RadioButton 
                            Content="Phone" 
                            Value="Phone" 
                            GroupName="ContactMethod"
                            IsChecked="{Binding PreferredContact, Converter={StaticResource StringToValueConverter}, ConverterParameter='Phone'}" />
                        <RadioButton 
                            Content="Text" 
                            Value="Text" 
                            GroupName="ContactMethod"
                            IsChecked="{Binding PreferredContact, Converter={StaticResource StringToValueConverter}, ConverterParameter='Text'}" />
                        <RadioButton 
                            Content="Email" 
                            Value="Email" 
                            GroupName="ContactMethod"
                            IsChecked="{Binding PreferredContact, Converter={StaticResource StringToValueConverter}, ConverterParameter='Email'}" />
                    </StackLayout>
                </StackLayout>

                <!-- Comments -->
                <StackLayout Spacing="5">
                    <Label Text="Comments" FontAttributes="Bold" />
                    <Editor 
                        Placeholder="Additional comments"
                        Text="{Binding MemberInfo.Comments}"
                        HeightRequest="100" />
                </StackLayout>

                <!-- Error Message -->
                <Label 
                    Text="{Binding ErrorMessage}" 
                    TextColor="{StaticResource ErrorColor}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    Margin="0,10" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button 
                Grid.Column="0"
                Text="Logout"
                Command="{Binding LogoutCommand}"
                BackgroundColor="{StaticResource ErrorColor}" />
            <Button 
                Grid.Column="1"
                Text="Next"
                Command="{Binding SaveMemberInfoCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator 
            Grid.Row="0"
            Grid.RowSpan="2"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</ContentPage>
