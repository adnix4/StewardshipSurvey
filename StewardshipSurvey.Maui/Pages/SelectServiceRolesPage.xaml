<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StewardshipSurvey.Maui.SelectServiceRolesPage"
             Title="Select Service Roles"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20" RowSpacing="10">

        <Label Grid.Row="0"
               Text="Select the areas you are currently serving in"
               FontSize="18"
               FontAttributes="Bold" />

        <!-- Selection is the CollectionView's own, read back in SelectionChanged. That keeps
             the checked state honest without a value converter to translate a List&lt;int&gt;
             into a per-row bool. -->
        <CollectionView Grid.Row="1"
                        x:Name="ServiceRoleList"
                        ItemsSource="{Binding AllServiceRoles}"
                        SelectionMode="Multiple"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,5" Stroke="{StaticResource PrimaryColor}" StrokeThickness="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding AreaOfInvolvement}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondaryColor}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource ErrorColor}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        <Button Grid.Row="3"
                Text="Finish"
                Command="{Binding SaveServiceRolesCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />

        <ActivityIndicator Grid.Row="0"
                           Grid.RowSpan="4"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />
    </Grid>
</ContentPage>
