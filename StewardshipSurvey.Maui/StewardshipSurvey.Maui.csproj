<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<WindowsPackageType>None</WindowsPackageType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>St. Mark Stewardship Survey</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.stmark.stewardship</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.19041.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="!$([MSBuild]::IsOSPlatform('windows'))">14.2</SupportedOSPlatformVersion>

		<!-- Required for C# Hot Reload -->
		<UseHotReload>true</UseHotReload>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon, splash and any fonts dropped into Resources/Fonts. None of this existed:
		     the project had no Resources folder at all, so there was no icon, no splash and
		     nothing behind the OpenSans font the styles asked for. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<!-- From .NET 8, UseMaui no longer implies these package references, so the SDK asks
		     for them explicitly (MA002). The version has to match the installed workload;
		     the 8.0.80 pinned here before did not, and .Hosting is not a separate package -
		     it comes with Controls. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
		<PackageReference Include="Polly" Version="8.4.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="**\*.xaml" Handler="XamlHandler" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

</Project>
