<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<WindowsPackageType>None</WindowsPackageType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>St. Mark Stewardship Survey</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.stmark.stewardship</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.19041.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="!$([MSBuild]::IsOSPlatform('windows'))">14.2</SupportedOSPlatformVersion>

		<!-- Required for C# Hot Reload -->
		<UseHotReload>true</UseHotReload>
	</PropertyGroup>

	<ItemGroup>
		<!-- Microsoft.Maui.Controls and .Hosting are supplied by the MAUI workload when
		     UseMaui is true. Pinning them here also made them unresolvable: they ship in
		     the SDK's library-packs folder, which this repo's NuGet package source mapping
		     does not cover. -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
		<PackageReference Include="Polly" Version="8.4.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="**\*.xaml" Handler="XamlHandler" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

</Project>
